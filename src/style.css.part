<style>
  /* Safari 9 safe: no grid, no CSS variables, prefixed flex */
  * { box-sizing: border-box; -webkit-box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    background: #F4F1EC; color: #22252B;
    font-family: "Avenir Next", "Helvetica Neue", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased; overflow: hidden;
  }
  .wrap { width: 1024px; height: 768px; margin: 0 auto; padding: 22px 24px; }

  /* Top bar */
  .top {
    height: 128px; border-radius: 20px; padding: 0 30px;
    background: #1F2A44; color: #fff;
    display: -webkit-flex; display: flex;
    -webkit-align-items: center; align-items: center;
    -webkit-justify-content: space-between; justify-content: space-between;
  }
  .day { font-size: 20px; letter-spacing: 3px; text-transform: uppercase; color: #F2C14E; font-weight: 600; }
  .date { font-size: 46px; font-weight: 600; line-height: 1.1; }
  .wx { display: -webkit-flex; display: flex; -webkit-align-items: center; align-items: center; }
  .wx-now { text-align: right; margin-right: 28px; }
  .wx-temp { font-size: 52px; font-weight: 300; line-height: 1; }
  .wx-desc { font-size: 17px; color: #C9D2E6; margin-top: 4px; }
  .wx-days { border-left: 1px solid #3A4766; padding-left: 24px; }
  .wx-d { font-size: 16px; color: #C9D2E6; line-height: 1.7; }
  .wx-d b { color: #fff; font-weight: 600; display: inline-block; width: 46px; }

  /* Panels */
  .row { display: -webkit-flex; display: flex; height: 550px; margin-top: 18px; }
  .panel { border-radius: 20px; background: #fff; overflow: hidden; }
  .left { -webkit-flex: 1; flex: 1; margin-right: 22px; }
  .right { -webkit-flex: 1.15; flex: 1.15; }
  .ph { padding: 16px 24px; font-size: 15px; letter-spacing: 2.5px; text-transform: uppercase; font-weight: 700; }
  .cal .ph { background: #DCEBF2; color: #1D5B79; }
  .menu .ph { background: #FBE3D6; color: #A3471C; }
  .pb { padding: 6px 24px 16px; }

  /* Calendar */
  .dayblock { padding: 5px 0 4px; border-bottom: 1px solid #EFECE6; }
  .dayblock:last-child { border-bottom: 0; }
  .dlabel { font-size: 14px; font-weight: 700; color: #8A8F98; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 4px; }
  .dlabel.today { color: #1D5B79; }
  .ev { font-size: 19px; line-height: 1.5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ev .t { display: inline-block; width: 92px; color: #5B616B; font-size: 17px; }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 5px; margin-right: 10px; vertical-align: 2px; }
  .p { background: #3B82C4; } .w { background: #7A5AC8; } .f { background: #3FA36B; } .h { background: #E0A12B; }
  .keys { margin-top: 10px; background: #FFF7E6; border-radius: 12px; padding: 10px 14px; font-size: 16px; color: #7A5A12; }
  .keys b { color: #5C4208; }
  .legend { font-size: 13px; color: #8A8F98; margin-top: 10px; }
  .legend span { margin-right: 14px; }

  /* Menu */
  .mrow { display: -webkit-flex; display: flex; -webkit-align-items: center; align-items: center; min-height: 74px; padding: 10px 0; border-bottom: 1px solid #F3EEE8; }
  .mrow:last-child { border-bottom: 0; }
  .md { width: 62px; -webkit-flex-shrink: 0; flex-shrink: 0; font-size: 15px; font-weight: 700; color: #B07A5C; text-transform: uppercase; letter-spacing: 1.5px; }
  .mdish { font-size: 22px; line-height: 1.3; }
  .mside { font-size: 16px; color: #8A8F98; }
  .mrow.today { background: #FFF1E8; margin: 0 -24px; padding: 12px 24px; border-left: 6px solid #E07A4C; border-bottom: 0; }
  .mrow.today .md { color: #E07A4C; }
  .mrow.today .mdish { font-weight: 600; font-size: 22px; }
  

  /* Slideshow */
  .stage { position: relative; height: 696px; }
  .slide { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; z-index: 0;
    -webkit-transition: opacity 0.8s ease; transition: opacity 0.8s ease; }
  .slide.on { opacity: 1; z-index: 1; }
  .full { height: 100%; }
  .phs { float: right; font-size: 12px; letter-spacing: 1px; text-transform: none; font-weight: 600; opacity: 0.75; }
  .phs .dot { margin: 0 5px 0 12px; width: 9px; height: 9px; }
  .foot { height: 20px; margin-top: 8px; font-size: 11px; color: #B4B0A8; position: relative; }
  .dots { position: absolute; left: 50%; top: 4px; margin-left: -100px; width: 200px; white-space: nowrap; text-align: center; }
  .sd { display: inline-block; width: 8px; height: 8px; border-radius: 4px; background: #D6D1C8; margin: 0 4px; }
  .sd.on { background: #1F2A44; width: 22px; }
  .upd { position: absolute; right: 0; top: 3px; }
  .pz { display: none; position: absolute; left: 0; top: 0; background: #1F2A44; color: #fff; font-size: 12px; padding: 2px 10px; border-radius: 10px; }

  /* Verse */
  .verse { background: #3B2A1E; color: #FBEBD3; }
  .verse .ph { background: #4A3424; color: #F2C14E; }
  .verse .pb { padding: 56px 60px; text-align: center; }
  .qt-mk { font-family: Georgia, serif; font-size: 150px; line-height: 0.8; color: #F2C14E; margin-top: 80px; height: 80px; }
  .qt-t { font-family: Georgia, "Times New Roman", serif; font-size: 46px; line-height: 1.4; font-style: italic; margin: 20px auto 0; width: 840px; }
  .qt-by { font-size: 22px; letter-spacing: 3px; text-transform: uppercase; color: #F2C14E; margin-top: 40px; font-weight: 600; }
  .vs-sk { font-family: "Kohinoor Devanagari", "Devanagari Sangam MN", "Noto Sans Devanagari", sans-serif; font-size: 34px; line-height: 1.6; color: #F2C14E; }
  .vs-tr { font-size: 19px; font-style: italic; color: #C9B396; margin-top: 14px; line-height: 1.5; }
  .vs-en { font-size: 31px; line-height: 1.45; margin-top: 34px; font-weight: 500; }
  .vs-by { font-size: 15px; letter-spacing: 2px; text-transform: uppercase; color: #A88D6C; margin-top: 22px; }

  /* Headlines */
  .news { background: #1A2238; color: #F2F4F8; }
  .news .ph { background: #253050; color: #F2C14E; }
  .news .pb { padding: 4px 30px; }
  .nw { display: -webkit-flex; display: flex; -webkit-align-items: center; align-items: center; height: 124px; border-bottom: 1px solid #2E3A5C; }
  .nw:last-child { border-bottom: 0; }
  .nn { width: 66px; -webkit-flex-shrink: 0; flex-shrink: 0; font-size: 50px; font-weight: 300; color: #F2C14E; }
  .nt { font-size: 28px; line-height: 1.28; font-weight: 500; color: #FFFFFF; }
  .ns { font-size: 15px; color: #9FB0D0; margin-top: 4px; text-transform: uppercase; letter-spacing: 1px; }

  /* Markets */
  .mkts .ph { background: #DDEFE3; color: #23704A; }
  .mkts .pb { padding: 16px 18px; }
  .mkw { overflow: hidden; }
  .mk { float: left; width: 300px; height: 296px; margin: 0 6px 12px; background: #F7F6F2; border-radius: 16px; padding: 16px 20px; }
  .mkn { font-size: 17px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #5B616B; }
  .mkp { font-size: 44px; font-weight: 600; margin-top: 10px; }
  .mku { font-size: 20px; color: #8A8F98; font-weight: 500; margin-right: 4px; }
  .mkc { font-size: 21px; font-weight: 600; margin: 4px 0 22px; }
  .up { color: #2E9E62; } .dn { color: #D2493B; }
  .mka { font-size: 14px; margin-top: 10px; color: #A0A4AB; margin-top: 6px; }

  /* Air & weather */
  .air .ph { background: #D7EEF0; color: #1F6B73; }
  .air .pb { padding: 24px 24px; }
  .awtop { display: -webkit-flex; display: flex; height: 340px; }
  .aq { width: 360px; border-radius: 18px; color: #fff; padding: 20px 26px; margin-right: 20px; }
  .aql { font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; opacity: 0.9; }
  .aqn { font-size: 110px; font-weight: 300; line-height: 1; margin-top: 8px; }
  .aqb { font-size: 30px; font-weight: 600; }
  .aqp { font-size: 17px; margin-top: 6px; opacity: 0.9; }
  .aqt { font-size: 19px; margin-top: 14px; line-height: 1.35; }
  .wn { -webkit-flex: 1; flex: 1; }
  .wnt { font-size: 72px; font-weight: 300; line-height: 1.1; }
  .wnt span { font-size: 30px; color: #5B616B; font-weight: 500; }
  .wst { display: -webkit-flex; display: flex; -webkit-flex-wrap: wrap; flex-wrap: wrap; margin-top: 12px; }
  .st { width: 33.3%; padding: 14px 0; border-top: 1px solid #EFECE6; }
  .stl { font-size: 15px; color: #8A8F98; text-transform: uppercase; letter-spacing: 1px; }
  .stv { font-size: 30px; font-weight: 600; margin-top: 2px; }
  .fc { display: -webkit-flex; display: flex; margin-top: 24px; }
  .fd { -webkit-flex: 1; flex: 1; background: #F7F6F2; border-radius: 14px; margin-right: 10px; padding: 14px 14px; height: 210px; }
  .fd:last-child { margin-right: 0; }
  .fd.today { background: #E3F2F3; }
  .fdn { font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #1F6B73; }
  .fdw { font-size: 19px; margin-top: 10px; height: 52px; line-height: 1.3; }
  .fdt { font-size: 32px; font-weight: 600; margin-top: 4px; }
  .fdt span { font-size: 21px; color: #8A8F98; font-weight: 400; }
  .fdr { font-size: 17px; color: #3B82C4; margin-top: 4px; }

  /* Kannada */
  .kan .ph { background: #FCE9C8; color: #9A5B00; }
  .kan .pb { padding: 70px 40px; text-align: center; }
  .kn-w { font-size: 104px; font-weight: 600; line-height: 1.2; color: #B5121B; margin-top: 10px; }
  .kn-tr { font-size: 26px; font-style: italic; color: #5B616B; margin-top: 2px; }
  .kn-m { font-size: 46px; font-weight: 600; margin-top: 8px; }
  .kn-ex { margin: 50px auto 0; width: 600px; background: #FFF7E6; border-radius: 18px; padding: 18px 26px; }
  .kn-el { font-size: 15px; text-transform: uppercase; letter-spacing: 2px; font-weight: 700; color: #9A5B00; }
  .kn-es { font-family: "Kannada Sangam MN", "Noto Sans Kannada", sans-serif; font-size: 30px; margin-top: 8px; }
  .kn-et { font-size: 34px; font-style: italic; color: #22252B; font-weight: 500; margin-top: 10px; }
  .kn-row { display: -webkit-flex; display: flex; text-align: left; }
  .kn-main { -webkit-flex: 1; flex: 1; text-align: center; padding-right: 30px; }
  .kn-rev { width: 250px; -webkit-flex-shrink: 0; flex-shrink: 0; border-left: 2px solid #F3E2C2; padding-left: 26px; }
  .kn-rh { font-size: 15px; text-transform: uppercase; letter-spacing: 2px; font-weight: 700; color: #9A5B00; margin-bottom: 18px; }
  .kr { padding: 9px 0; border-bottom: 1px solid #F6EAD3; }
  .kr:last-child { border-bottom: 0; }
  .krw { font-size: 26px; font-weight: 600; color: #B5121B; }
  .krm { font-size: 19px; color: #5B616B; margin-top: 3px; }
  .kn-ee { font-size: 28px; color: #5B616B; margin-top: 8px; }


  /* Wedding */
  .wed .ph { background: #F3EAD3; color: #5F6B22; }
  .wed .pb { padding: 0; }
  .wd { text-align: center; height: 652px; padding-top: 18px; background-color: #FAF6F1; background-size: cover; background-position: center bottom; }
  .wd-top { height: 150px; }
  .wd-logo { height: 150px; }
  .wd-mono { display: inline-block; width: 120px; height: 120px; border-radius: 60px; border: 2px solid #E5A41E; color: #6B7430; font-family: "Didot", "Bodoni 72", Georgia, serif; font-size: 34px; line-height: 116px; font-style: italic; }
  .wd-n { font-family: "Didot", "Bodoni 72", Georgia, serif; font-size: 150px; font-weight: 700; line-height: 1; color: #6B7430; margin-top: 44px; }
  .wd-l { font-size: 22px; letter-spacing: 6px; text-transform: uppercase; font-weight: 700; color: #D4901A; margin-top: 2px; }
  .wd-d { font-size: 24px; color: #4E5540; margin-top: 8px; font-weight: 500; }
  .wd-tiles { display: -webkit-flex; display: flex; margin: 38px 22px 0; }
  .wt { -webkit-flex: 1; flex: 1; width: 0; margin: 0 9px; border-radius: 16px; padding: 18px 14px; height: 140px; border: 3px solid #E5A41E; }
  .wt-v { background: rgba(232,243,241,0.93); border-color: #5E9C99; }
  .wt-r { background: rgba(240,242,224,0.93); border-color: #8A9440; }
  .wt-w { background: rgba(253,236,224,0.93); border-color: #E8845A; }
  .wtl { font-size: 14px; letter-spacing: 2px; text-transform: uppercase; font-weight: 700; color: #6F6A55; }
  .wtv { font-size: 32px; font-weight: 600; color: #22252B; margin-top: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wtv span { font-size: 20px; font-weight: 500; color: #7A7F86; margin-left: 6px; }
  .wts { font-size: 16px; color: #6F737A; margin-top: 6px; }

  /* 7-day grid */
  .grid .ph { background: #DCEBF2; color: #1D5B79; }
  .grid .pb { padding: 12px 12px; }
  .gw { display: -webkit-flex; display: flex; }
  .gc { -webkit-flex: 1; flex: 1; width: 0; margin: 0 4px; height: 612px; overflow: hidden; background: #F7F6F2; border-radius: 14px; padding: 8px; }
  .gc.today { background: #E6F0F6; }
  .gh { text-align: center; padding: 4px 0 8px; border-bottom: 1px solid #E4E0D8; margin-bottom: 6px; }
  .ghd { font-size: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #8A8F98; }
  .ghn { font-size: 36px; font-weight: 600; line-height: 1.1; }
  .gc.today .ghd, .gc.today .ghn { color: #1D5B79; }
  .ge { background: #fff; border-radius: 8px; padding: 7px 8px; margin-bottom: 8px; border-left: 4px solid #3B82C4; }
  .ge.w { border-left-color: #7A5AC8; } .ge.h { border-left-color: #E0A12B; } .ge.f { border-left-color: #3FA36B; }
  .gt { font-size: 13px; color: #8A8F98; font-weight: 600; }
  .gs { font-size: 16px; line-height: 1.25; overflow: hidden; max-height: 60px; }
  .gm { font-size: 12px; color: #8A8F98; text-align: center; margin-top: 6px; }
  /* vouchers */
  .vch .ph { background: #E6DDF3; color: #5B3A8C; }
  .vch .pb { padding: 18px 36px; }
  .vhd { display: -webkit-flex; display: flex; font-size: 14px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #8A8F98; padding: 6px 0 12px; border-bottom: 2px solid #EFECE6; }
  .vr { display: -webkit-flex; display: flex; -webkit-align-items: center; align-items: center; height: 94px; border-bottom: 1px solid #EFECE6; }
  .vn { -webkit-flex: 1; flex: 1; font-size: 30px; font-weight: 600; }
  .vtag { display: inline-block; font-size: 15px; font-weight: 600; color: #5B3A8C; background: #F1ECF8; border-radius: 10px; padding: 3px 10px; margin-left: 12px; vertical-align: middle; }
  .vv { width: 170px; font-size: 30px; font-weight: 600; text-align: right; }
  .ve { width: 210px; font-size: 22px; color: #555B66; text-align: right; }
  .vd { width: 220px; text-align: right; }
  .vr .vd { font-size: 17px; }
  .vr .vd b { display: inline-block; font-size: 30px; font-weight: 700; color: #fff; border-radius: 12px; padding: 6px 14px; margin-right: 6px; min-width: 70px; text-align: center; }
  .vd.red b { background: #C62828; } .vd.red { color: #C62828; }
  .vd.amb b { background: #E09B1B; } .vd.amb { color: #B57400; }
  .vd.grn b { background: #2E8B57; } .vd.grn { color: #2E8B57; }
  .dayblock.today { background: #E6F1F7; margin: 0 -24px; padding: 5px 18px 4px; border-left: 6px solid #2F7FB0; border-bottom: 0; }
  .dayblock.today .dlabel { color: #2F7FB0; }
  .dayblock.today .ev { font-weight: 600; }
  .vhd span { font-size: 14px; font-weight: 700; color: #8A8F98; }
  .vhd .vn { display: block; }
  .mls .ph { background: #DCEBF5; color: #1F5F8B; }
  .mls .pb { padding: 18px 36px; }
  .mr .vn { font-size: 30px; font-weight: 700; }
  .mb { width: 340px; font-size: 30px; font-weight: 700; text-align: right; color: #22262E; }
  .me { width: 240px; font-size: 22px; color: #555B66; text-align: right; }
  .ma { width: 150px; font-size: 16px; color: #8A8F98; text-align: right; }
  .vhd .mb, .vhd .me, .vhd .ma { font-size: 14px; font-weight: 700; color: #8A8F98; }
</style>
